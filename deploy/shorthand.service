[Unit]
Description=Shorthand Server
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=shorthand
Group=shorthand
WorkingDirectory=/opt/shorthand
EnvironmentFile=/opt/shorthand/.env

ExecStart=/usr/bin/java \
    -Xms128m -Xmx256m \
    -XX:MaxMetaspaceSize=128m \
    -XX:+UseSerialGC \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/opt/shorthand/logs/heapdump.hprof \
    -Dfile.encoding=UTF-8 \
    -Duser.timezone=Asia/Shanghai \
    -jar /opt/shorthand/releases/server.jar \
    --spring.profiles.active=prod \
    --server.address=127.0.0.1 \
    --server.port=8081

MemoryHigh=380M
MemoryMax=420M

Restart=always
RestartSec=10
SuccessExitStatus=143

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shorthand

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/shorthand

[Install]
WantedBy=multi-user.target
