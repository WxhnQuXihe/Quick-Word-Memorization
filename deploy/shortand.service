[Unit]
Description=Shortand Server
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=shortand
Group=shortand
WorkingDirectory=/opt/shortand
EnvironmentFile=/opt/shortand/.env

ExecStart=/usr/bin/java \
    -Xms128m -Xmx256m \
    -XX:MaxMetaspaceSize=128m \
    -XX:+UseSerialGC \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/opt/shortand/logs/heapdump.hprof \
    -Dfile.encoding=UTF-8 \
    -Duser.timezone=Asia/Shanghai \
    -jar /opt/shortand/releases/server.jar \
    --spring.profiles.active=prod \
    --server.address=127.0.0.1 \
    --server.port=8081

MemoryHigh=380M
MemoryMax=420M

Restart=always
RestartSec=10
SuccessExitStatus=143

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shortand

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/shortand

[Install]
WantedBy=multi-user.target
